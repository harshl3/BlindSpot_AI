# ==========================================
# Root .gitignore for BlindSpot AI
# ==========================================

# Environment variables & secrets (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
*.local

# Node.js dependencies & build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
coverage/

# Java / Spring Boot build artifacts
target/
backend/target/
build/
backend/build/
*.class
*.jar
*.war
*.ear

# Maven wrapper distribution caches & local tools
.tools/
.m2/

# IDE / Editor configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.project
.classpath
.settings/
.springBeans
.sts4-cache

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

