# ==========================================
# BlindSpot AI - Frontend Client Config
# ==========================================

# Firebase Web Configuration (Get from your Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend API Base URL
# Local development: leave empty (Vite automatically proxies /api to http://localhost:8080)
# Production (Render Static Site): set to your deployed backend URL:
# VITE_API_BASE_URL=https://blindspot-backend.onrender.com
VITE_API_BASE_URL=
